<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>LL.Observabilidad</PackageId>
    <Description>Nombres estables de trazas y métricas para la cola de eventos, correlación por identificador de evento, propagación del contexto W3C entre publicar y ack y registro que nunca copia la carga.</Description>
    <PackageTags>observabilidad;trazas;metricas;logging;eventos;opentelemetry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
